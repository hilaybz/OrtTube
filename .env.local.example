# Copy this file to `.env.local` and fill in real values for local development.

# ── Anthropic ──────────────────────────────────────────────────────────────
# Claude API key — required for quiz generation, translation, and the AI tutor.
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ────────────────────────────────────────────────────────────────
# Local dev uses the Supabase CLI stack (`supabase start`). The URL + anon/
# service-role keys are printed by `supabase start` / `supabase status`.
# Reuse NEXT_PUBLIC_SUPABASE_URL everywhere — do NOT introduce a second
# SUPABASE_URL var. The service-role key bypasses RLS and is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Supabase CLI local default). Used by the test
# harness to reset/seed and by any Node-side raw SQL.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Storage (transcript cache) ──────────────────────────────────────────────
# Supabase Storage bucket that holds cached YouTube transcripts (one JSON object
# per youtube_video_id). Defaults to `transcripts`.
TRANSCRIPT_BUCKET=transcripts

# ── YouTube egress (transcript proxy) ───────────────────────────────────────
# YouTube bot-checks datacenter IPs, and Vercel's functions run on one. It walls
# `api/timedtext` — the caption download — hardest of all: measured, 0 of 10
# datacenter proxies could fetch a single subtitle, while every one of them was
# served the player metadata quite happily. RESIDENTIAL egress is required, and
# it is the reason transcripts work at all in production.
#
# LEAVE EMPTY LOCALLY. A dev machine is normally on a residential IP that
# YouTube already serves, so the direct path works and costs no bandwidth.
# Empty here means "no proxy", which is also the kill switch: clearing this
# variable in Vercel disables proxying without a code change.
#
# Comma-separated, tried in order with the last-known-good one preferred. Both
# forms are accepted, so a provider's dashboard export can be pasted as-is:
#   http://user:pass@host:port
#   host:port:user:pass
#
# Use a ROTATING endpoint, and list it several times:
#   p.webshare.io:80:USER-rotate:PASS,p.webshare.io:80:USER-rotate:PASS,...
# Each entry becomes its own connection and therefore its own exit IP, which is
# what gives a refused request somewhere to fall through to. A dashboard's
# `USER-gb-1` style sticky session is the WRONG choice here — it pins to one IP
# and will burn like a static proxy.
#
# Changing provider is a change to THIS VALUE only — no code change, since the
# pool interface is the same either way.
YOUTUBE_PROXY_URLS=

# ── Job / admin endpoint secrets ────────────────────────────────────────────
# Two SEPARATE secrets so a leaked cron secret cannot create teachers or delete
# users. `CRON_SECRET` guards scheduled jobs under /api/jobs/*; `ADMIN_SECRET`
# guards destructive admin endpoints (/api/admin/seed-teacher, /delete-user).
# Both are checked as `Authorization: Bearer <secret>`.
CRON_SECRET=generate-a-long-random-string
ADMIN_SECRET=generate-a-different-long-random-string
