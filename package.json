{
  "name": "orttube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:int": "REQUIRE_STACK=1 vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --project ui",
    "e2e": "playwright test",
    "seed": "node --env-file=.env.local scripts/seed-fixture.mjs",
    "probe:proxy": "node --env-file=.env.local scripts/probe-proxy.mjs",
    "smoke": "node test/e2e/smoke.mjs",
    "db:push": "bash scripts/db-push.sh",
    "gen:types": "sh scripts/gen-types.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-youtube": "^10.1.0",
    "server-only": "^0.0.1",
    "undici": "^8.10.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "supabase": "2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6",
    "ws": "^8.21.0"
  }
}
